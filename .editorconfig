root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all      # klamra w nowej linii (styl Unity/MS)
csharp_space_after_keywords_in_control_flow_statements = true